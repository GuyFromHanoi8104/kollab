# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Weaviate Cloud cluster (Console -> your cluster -> Details)
WEAVIATE_URL=xxxxxxxx.c0.region.aws.weaviate.cloud
WEAVIATE_API_KEY=

# Used by the text2vec_openai vectorizer at ingest and query time
OPENAI_API_KEY=

# Supabase project (Dashboard -> Project Settings -> API)
# A read-only/anon key is enough for ingest, but RLS may hide rows from it.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /webhooks/profiles. Generate a long random value and
# put the same one in Supabase's Database Webhook config as a custom HTTP
# header named X-Webhook-Secret. Unset disables the endpoint (fails closed).
PROFILE_WEBHOOK_SECRET=
